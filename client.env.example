# Copy to client.env (git-ignored), fill in, then run: ./scripts/fill-placeholders.sh client.env
# Values only. NEVER put passwords, tokens, or account numbers here.
CLIENT_NAME="Example Co LLC"
CLIENT_SHORT="example-co"
INDUSTRY="Landscaping"
CLIENT_WEBSITE="https://example.com"
CLIENT_LOCATION="City, State"
PRIMARY_CONTACT="Pat Example"
PRIMARY_CONTACT_ROLE="Owner"
PRIMARY_CONTACT_EMAIL="pat@example.com"
BACKUP_CONTACT="Sam Example"
BOT_NAME="Ops Assistant"
TIMEZONE="America/New_York"
PROVIDER_NAME="Your setup business name"
PROVIDER_CONTACT="support@example.net"
VAULT_REPO="github-org/example-co-grok-vault"
PASSWORD_MANAGER="1Password vault 'Example Co - Bot'"
START_DATE="2026-01-15"
GO_LIVE_DATE="2026-02-15"
SERVICE_TIER="Starter"
REVIEW_DAY="Friday"
# Bot team (Team/). Leave a role's name as "(not used)" if the client does not take it.
RECORD_KEEPER_BOT_NAME="Record Keeper"
COORDINATOR_BOT_NAME="Coordinator"
BRIEFING_BOT_NAME="Weekly Brief"
LIAISON_BOT_NAME="Channel Liaison"
IDEA_BOT_NAME="Idea Partner"
CONTENT_BOT_NAME="Content Producer"
CONTENT_TYPE="how-to videos and training guides"
# Nightly fleet review (Skills/Nightly fleet review.md), run by the Coordinator. Local time, HH:MM in TIMEZONE.
FLEET_REVIEW_TIME="21:30"
# Where the team status page lives (a vault note or the page the client uses); the fleet review keeps one section there.
STATUS_PAGE="Reports/Team status.md"
# Issue label in the vault repo for rules-change alerts (proposed or detected changes to GROK.md, Bot playbook, Bot configuration, Access list).
RULES_ALERT_LABEL="rules-change"
# The only writer of Reports/Time savings log.csv (Reference/Time savings log.md). Usually the Record Keeper.
REPORTS_BOT_NAME="Record Keeper"
BRIEF_TOPIC="security advisories and vendor changes for the tools we use"
BRIEF_DAY="Monday"
CHAT_PLATFORM="Slack"
LIAISON_CHANNEL="#example-partner-channel"
# Pilot (Team/Pilot program.md)
PILOT_START_DATE="2026-01-15"
PILOT_END_DATE="2026-02-14"
PILOT_READOUT_DATE="2026-02-16"
# Service packages (Team/Service packages.md). Set by the provider; never guessed.
PRICE_PILOT="(set by provider)"
PRICE_STARTER_SETUP="(set by provider)"
PRICE_STARTER_MONTHLY="(set by provider)"
PRICE_TEAM_SETUP="(set by provider)"
PRICE_TEAM_MONTHLY="(set by provider)"
PRICE_MANAGED_MONTHLY="(set by provider)"
PRICE_ADDON_ROLE="(set by provider)"
PRICE_CHANGE_REQUEST="(set by provider)"
PRICE_ADDON_SKILL="(set by provider)"
PRICE_ADDON_DEMO="(set by provider)"
PRICE_ADDON_CONTENT="(set by provider)"
PRICE_ADDON_TEMPLATE="(set by provider)"
PRICE_ADDON_CONNECTOR="(set by provider)"
SUPPORT_RESPONSE_TIME="(set in the agreement)"
# Provider sales materials (Sales/). Provider values, the same for every prospect. Never guessed.
# CLAIM_* values must come from a measured pilot readout the client agreed to share; otherwise delete that line from the doc.
PROVIDER_WEBSITE="https://example.net"
PROVIDER_PHONE="(000) 000-0000"
BOOKING_LINK="https://example.net/book"
PRICE_EFFECTIVE_DATE="2026-01-01"
CURRENCY="USD"
TAX_NOTE="(set by provider, e.g. whether tax is included)"
SUPPORT_HOURS="(set in the agreement)"
MANAGED_SETUP_TERMS="(set by provider)"
PILOT_CREDIT_TERMS="(set by provider, or delete if no credit)"
SETUP_PAYMENT_TERMS="(set in the agreement)"
BILLING_TERMS="(set in the agreement)"
PAYMENT_TERMS="(set in the agreement)"
MINIMUM_TERM="(set in the agreement)"
CANCELLATION_NOTICE="(set in the agreement)"
QUOTE_VALID_DAYS="(set by provider)"
CLAIM_HOURS_SAVED="(measured pilot result only)"
# Provider business planning (Business/). Provider-internal; delete Business/ from client copies.
# HOURS_*, CAPACITY_*, COST_*: measure or decide, never guess. TARGET_*: targets the provider sets, reviewed monthly.
# EXAMPLE_*: counts for the worked revenue example only. Per-message fields like {{prospect_first_name}} are lower case and filled by hand.
CAPACITY_BUFFER_PERCENT="(set by provider)"
