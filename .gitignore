# Obsidian workspace state and plugin settings (per-device, may hold tokens)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/*/data.json
.obsidian/plugins/
.trash/

# Never commit secrets or local env files
.env
*.env
!client.env.example
# Exception: the fictional demo business's filled env (example data only, never real values)
!Business/Demo vault/client.env
*.pem
*.key
*credentials*
*secret*

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Real client-data denylist for scripts/check-no-client-data.sh. It contains real names,
# so the provider keeps it locally and it can never be in the repo. Format: scripts/denylist.example.txt
scripts/denylist.txt
